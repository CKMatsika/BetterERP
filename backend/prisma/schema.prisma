// BetterERP - Production multi-branch ERP + POS database schema
// Database: PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATION STRUCTURE
// ============================================================

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String?
  vatNumber          String?
  address            String?
  city               String?
  country            String   @default("Zimbabwe")
  phone              String?
  email              String?
  website            String?
  currency           String   @default("USD")
  baseCurrency       String   @default("USD")
  fiscalYearStart    DateTime
  isHq               Boolean  @default(true)
  logoUrl            String?
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branches       Branch[]
  addresses      CompanyAddress[]
  accounts       Account[]
  currencies     Currency[]
  users          User[]
  recipes        Recipe[]
  productionRuns ProductionRun[]
}

model CompanyAddress {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  type      String // STREET, POSTAL, PHYSICAL
  line1     String
  line2     String?
  city      String
  province  String?
  country   String   @default("Zimbabwe")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Branch {
  id                      String       @id @default(cuid())
  companyId               String
  company                 Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  type                    String       @default("BRANCH") // HQ, BRANCH, WAREHOUSE_ONLY
  address                 String?
  city                    String?
  phone                   String?
  email                   String?
  managerUserId           String?
  managerName             String?
  status                  EntityStatus @default(ACTIVE)
  currency                String?      @default("USD")
  defaultWarehouseId      String?
  taxConfiguration        Json?
  accountingConfiguration Json?
  posConfiguration        Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  warehouses       Warehouse[]
  users            User[]
  employees        Employee[]
  accounts         Account[]
  cashAccounts     Account[]         @relation("BranchCashAccounts")
  bankAccounts     BankAccount[]
  customers        Customer[]
  suppliers        Supplier[]
  products         ProductBranch[] // branch-specific product config
  sales            Sale[]
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  transfersOut     StockTransfer[]   @relation("TransferSourceBranch")
  transfersIn      StockTransfer[]   @relation("TransferDestinationBranch")
  productionRuns   ProductionRun[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  isDefault Boolean      @default(false)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  locations      WarehouseLocation[]
  stockBalances  StockBalance[]
  stockCounts    StockCount[]
  productionRuns ProductionRun[]

  @@unique([branchId, code])
  @@index([branchId])
}

model WarehouseLocation {
  id          String       @id @default(cuid())
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  stockBalances StockBalance[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model Department {
  id            String       @id @default(cuid())
  companyId     String
  code          String
  name          String
  description   String?
  managerId     String?
  defaultMarkup Decimal?     @db.Decimal(12, 4)
  defaultGp     Decimal?     @db.Decimal(12, 4)
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employees     Employee[]
  costCentres   CostCentre[]
  profitCentres ProfitCentre[]
  products      Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

model CostCentre {
  id           String       @id @default(cuid())
  companyId    String
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  code         String
  name         String
  description  String?
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

model ProfitCentre {
  id           String       @id @default(cuid())
  companyId    String
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  code         String
  name         String
  description  String?
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================

model User {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  username           String    @unique
  email              String?   @unique
  fullName           String
  phone              String?
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  canViewAllBranches Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                   UserRole[]
  loginHistory            LoginHistory[]
  auditLogs               AuditLog[]
  employee                Employee?
  notifications           UserNotification[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  stockAdjustmentsCreated StockAdjustment[]    @relation("AdjustmentCreator")
  salesAsCashier          Sale[]               @relation("SaleCashier")
  shiftsAsCashier         POSShift[]           @relation("ShiftCashier")
  stockMovements          StockMovement[]      @relation("StockMovementUser")
  expensesPaid            Expense[]            @relation("ExpensePaidBy")
  blocktestsCreated       Blocktest[]          @relation("BlocktestCreator")
  productionRuns          ProductionRun[]

  @@index([companyId])
  @@index([branchId])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions    RolePermission[]
  users          UserRole[]
  approvalLevels ApprovalLevel[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  resource    String
  action      String // view, create, edit, delete, approve, post, cancel, reverse, export, print
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId  String?
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@index([branchId])
}

model LoginHistory {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String?
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?

  @@index([userId])
  @@index([loginAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  isRevoked Boolean   @default(false)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// PRODUCT MASTER
// ============================================================

model Category {
  id          String       @id @default(cuid())
  companyId   String
  parentId    String?
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryTree")
  code        String
  name        String
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Brand {
  id        String       @id @default(cuid())
  companyId String
  name      String
  code      String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  isBase    Boolean  @default(false)
  createdAt DateTime @default(now())

  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

enum ProductType {
  STOCK
  SERVICE
  NON_STOCK
  ASSET
}

enum CostingMethod {
  WEIGHTED_AVERAGE
  FIFO
  STANDARD
}

model Product {
  id                  String         @id @default(cuid())
  companyId           String
  sku                 String
  barcode             String?
  name                String
  description         String?
  departmentId        String?
  department          Department?    @relation(fields: [departmentId], references: [id])
  markup              Decimal?       @db.Decimal(12, 4)
  gp                  Decimal?       @db.Decimal(12, 4)
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id])
  subcategoryId       String?
  brandId             String?
  brand               Brand?         @relation(fields: [brandId], references: [id])
  unitOfMeasureId     String?
  unitOfMeasure       UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  purchaseUnit        String?
  stockUnit           String?
  salesUnit           String?
  packSize            Decimal?       @db.Decimal(12, 2)
  alternateUnits      Json?
  type                ProductType    @default(STOCK)
  costingMethod       CostingMethod  @default(WEIGHTED_AVERAGE)
  costPrice           Decimal?       @default(0) @db.Decimal(18, 4)
  averageCost         Decimal?       @default(0) @db.Decimal(18, 4)
  lastPurchasePrice   Decimal?       @db.Decimal(18, 4)
  sellingPrice        Decimal?       @db.Decimal(18, 4)
  wholesalePrice      Decimal?       @db.Decimal(18, 4)
  retailPrice         Decimal?       @db.Decimal(18, 4)
  specialPrice        Decimal?       @db.Decimal(18, 4)
  taxCategoryId       String?
  taxRateId           String?
  taxRate             TaxRate?       @relation(fields: [taxRateId], references: [id])
  reorderLevel        Decimal?       @default(0) @db.Decimal(18, 4)
  reorderQuantity     Decimal?       @default(0) @db.Decimal(18, 4)
  minimumStock        Decimal?       @default(0) @db.Decimal(18, 4)
  maximumStock        Decimal?       @db.Decimal(18, 4)
  preferredSupplierId String?
  preferredSupplier   Supplier?      @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  imageUrl            String?
  imagePath           String?
  serialRequired      Boolean        @default(false)
  batchRequired       Boolean        @default(false)
  expiryRequired      Boolean        @default(false)
  weight              Decimal?       @db.Decimal(12, 4)
  length              Decimal?       @db.Decimal(12, 4)
  width               Decimal?       @db.Decimal(12, 4)
  height              Decimal?       @db.Decimal(12, 4)
  allowNegative       Boolean        @default(false)
  isPosFeatured       Boolean        @default(false)
  posColor            String?
  status              EntityStatus   @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdById         String?

  suppliers            ProductSupplier[]
  aliases              ProductAlias[]
  priceHistory         ProductPriceHistory[]
  branchConfigs        ProductBranch[]
  stockBalances        StockBalance[]
  saleLines            SaleLine[]
  purchaseLines        PurchaseOrderLine[]
  movements            StockMovement[]
  goodsReceiptLines    GoodsReceiptLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockCountLines      StockCountLine[]
  stockTransferLines   StockTransferLine[]
  blocktestsAsRaw      Blocktest[]
  blocktestLines       BlocktestLine[]       @relation("BlocktestLineProduct")
  recipe               Recipe?
  recipeItems          RecipeItem[]
  productionLines      ProductionLine[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, departmentId])
  @@index([companyId, categoryId])
  @@index([companyId, brandId])
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([alias])
}

model ProductSupplier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierCode String?
  costPrice    Decimal? @db.Decimal(18, 4)
  leadTimeDays Int?
  isPreferred  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([productId, supplierId])
  @@index([supplierId])
}

model ProductBranch {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sellingPrice   Decimal?     @db.Decimal(18, 4)
  wholesalePrice Decimal?     @db.Decimal(18, 4)
  retailPrice    Decimal?     @db.Decimal(18, 4)
  specialPrice   Decimal?     @db.Decimal(18, 4)
  reorderLevel   Decimal?     @db.Decimal(18, 4)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId    String?
  field       String
  oldValue    Decimal? @db.Decimal(18, 4)
  newValue    Decimal? @db.Decimal(18, 4)
  changedById String?
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

// ============================================================
// INVENTORY
// ============================================================

enum StockMovementType {
  PURCHASE_RECEIPT
  SALES
  SALES_RETURN
  PURCHASE_RETURN
  BRANCH_TRANSFER_OUT
  BRANCH_TRANSFER_IN
  BRANCH_TRANSFER_RECEIVE
  STOCK_ADJUSTMENT
  STOCK_COUNT
  DAMAGE
  WRITE_OFF
  OPENING_STOCK
  INTERNAL_CONSUMPTION
  TRANSFER_IN_TRANSIT
  BLOCKTEST_RAW_CONSUMPTION
  BLOCKTEST_CUT_PRODUCTION
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

model StockMovement {
  id          String            @id @default(cuid())
  companyId   String
  branchId    String
  warehouseId String?
  reference   String
  type        StockMovementType
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  quantity    Decimal           @db.Decimal(18, 4)
  beforeQty   Decimal           @db.Decimal(18, 4)
  afterQty    Decimal           @db.Decimal(18, 4)
  unitCost    Decimal?          @db.Decimal(18, 4)
  totalCost   Decimal?          @db.Decimal(18, 4)
  sourceRef   String?
  sourceType  String?
  sourceId    String?
  userId      String?
  user        User?             @relation("StockMovementUser", fields: [userId], references: [id])
  note        String?
  createdAt   DateTime          @default(now())

  @@index([companyId, productId])
  @@index([branchId])
  @@index([type])
  @@index([sourceId])
  @@index([createdAt])
}

model StockBalance {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String?
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  onHand      Decimal            @default(0) @db.Decimal(18, 4)
  reserved    Decimal            @default(0) @db.Decimal(18, 4)
  available   Decimal            @default(0) @db.Decimal(18, 4)
  damaged     Decimal            @default(0) @db.Decimal(18, 4)
  inTransit   Decimal            @default(0) @db.Decimal(18, 4)
  ordered     Decimal            @default(0) @db.Decimal(18, 4)
  averageCost Decimal            @default(0) @db.Decimal(18, 4)
  value       Decimal            @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime           @updatedAt

  @@unique([productId, warehouseId, locationId])
  @@index([warehouseId])
  @@index([productId])
}

model StockAdjustment {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String
  warehouseId  String?
  reference    String
  type         String // STOCK_ADJUSTMENT, DAMAGE, WRITE_OFF, INTERNAL_CONSUMPTION, STOCK_COUNT
  note         String?
  status       String    @default("DRAFT") // DRAFT, PENDING, APPROVED, POSTED, CANCELLED
  postedAt     DateTime?
  postedById   String?
  createdById  String?
  createdBy    User?     @relation("AdjustmentCreator", fields: [createdById], references: [id])
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines StockAdjustmentLine[]

  @@index([companyId, branchId])
}

model StockAdjustmentLine {
  id             String          @id @default(cuid())
  adjustmentId   String
  adjustment     StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  locationId     String?
  quantityChange Decimal         @db.Decimal(18, 4)
  newOnHand      Decimal?        @db.Decimal(18, 4)
  reason         String?
  unitCost       Decimal?        @db.Decimal(18, 4)

  @@index([adjustmentId])
}

model StockCount {
  id               String    @id @default(cuid())
  companyId        String
  branchId         String
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  reference        String
  status           String    @default("DRAFT") // DRAFT, IN_PROGRESS, COUNTED, ADJUSTED, POSTED, CANCELLED
  countedById      String?
  countDate        DateTime  @default(now())
  varianceAccounts Json?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines StockCountLine[]

  @@index([companyId, branchId])
}

model StockCountLine {
  id         String     @id @default(cuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  locationId String?
  systemQty  Decimal    @db.Decimal(18, 4)
  countedQty Decimal    @db.Decimal(18, 4)
  variance   Decimal    @db.Decimal(18, 4)
  unitCost   Decimal?   @db.Decimal(18, 4)

  @@index([countId])
}

model Blocktest {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String
  warehouseId  String
  reference    String
  status       String    @default("DRAFT") // DRAFT, POSTED, CANCELLED
  rawProductId String
  rawProduct   Product   @relation(fields: [rawProductId], references: [id])
  carcassType  String
  rawWeight    Decimal   @db.Decimal(18, 4)
  rawCost      Decimal   @db.Decimal(18, 4)
  totalRevenue Decimal   @db.Decimal(18, 4)
  gpPerc       Decimal   @db.Decimal(12, 4)
  markupPerc   Decimal   @db.Decimal(12, 4)
  createdById  String?
  createdBy    User?     @relation("BlocktestCreator", fields: [createdById], references: [id])
  postedAt     DateTime?
  postedById   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines BlocktestLine[]

  @@index([companyId, branchId])
}

model BlocktestLine {
  id              String    @id @default(cuid())
  blocktestId     String
  blocktest       Blocktest @relation(fields: [blocktestId], references: [id], onDelete: Cascade)
  productId       String? // Link to the resulting cut product in inventory
  product         Product?  @relation("BlocktestLineProduct", fields: [productId], references: [id])
  cutName         String
  yieldPerc       Decimal   @db.Decimal(12, 4)
  estWeight       Decimal   @db.Decimal(18, 4)
  estCost         Decimal   @db.Decimal(18, 4)
  sellingPrice    Decimal   @db.Decimal(18, 4)
  expectedRevenue Decimal   @db.Decimal(18, 4)
  gpPerc          Decimal   @db.Decimal(12, 4)

  @@index([blocktestId])
}

// ============================================================
// SUPPLIERS & CUSTOMERS
// ============================================================

model Supplier {
  id            String       @id @default(cuid())
  companyId     String
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  code          String?
  name          String
  taxNumber     String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  province      String?
  country       String       @default("Zimbabwe")
  currency      String       @default("USD")
  creditLimit   Decimal?     @default(0) @db.Decimal(18, 4)
  paymentTerms  String?
  bankAccount   String?
  status        EntityStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products          ProductSupplier[]
  preferredProducts Product[]         @relation("PreferredSupplier")
  purchaseOrders    PurchaseOrder[]
  contacts          SupplierContact[]
  invoices          SupplierInvoice[]
  payments          SupplierPayment[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([branchId])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

model Customer {
  id                 String         @id @default(cuid())
  companyId          String
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  code               String?
  name               String
  customerType       String         @default("RETAIL") // RETAIL, WHOLESALE, CONTRACT, CREDIT
  groupId            String?
  group              CustomerGroup? @relation(fields: [groupId], references: [id])
  taxNumber          String?
  contactPerson      String?
  phone              String?
  email              String?
  address            String?
  city               String?
  province           String?
  country            String         @default("Zimbabwe")
  currency           String         @default("USD")
  creditLimit        Decimal?       @default(0) @db.Decimal(18, 4)
  creditApproved     Boolean        @default(false)
  creditApprovedById String?
  paymentTerms       String?
  priceTier          String? // RETAIL, WHOLESALE, SPECIAL
  status             EntityStatus   @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sales    Sale[]
  receipts CustomerReceipt[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([branchId])
}

model CustomerGroup {
  id        String       @id @default(cuid())
  companyId String
  name      String
  discount  Decimal?     @default(0) @db.Decimal(5, 2)
  priceTier String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  customers Customer[]

  @@unique([companyId, name])
}

// ============================================================
