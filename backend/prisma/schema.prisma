model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  quantity        Decimal       @db.Decimal(18, 4)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 4)
  backorderQty    Decimal       @default(0) @db.Decimal(18, 4)
  unitCost        Decimal       @db.Decimal(18, 4)
  taxRate         Decimal?      @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal       @default(0) @db.Decimal(18, 4)

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String
  warehouseId     String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  reference       String // GRN number
  receiptDate     DateTime       @default(now())
  status          String         @default("POSTED") // DRAFT, POSTED, CANCELLED
  receivedById    String?
  totalQty        Decimal        @default(0) @db.Decimal(18, 4)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines GoodsReceiptLine[]

  @@index([companyId, branchId])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String       @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  productId           String?
  product             Product?     @relation(fields: [productId], references: [id])
  quantity            Decimal      @db.Decimal(18, 4)
  unitCost            Decimal      @db.Decimal(18, 4)
  taxAmount           Decimal      @default(0) @db.Decimal(18, 4)
  lineTotal           Decimal      @default(0) @db.Decimal(18, 4)
  locationId          String?

  @@index([goodsReceiptId])
}

model SupplierInvoice {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id])
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  reference       String // supplier invoice number
  docReference    String // internal reference
  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  currency        String         @default("USD")
  exchangeRate    Decimal        @default(1) @db.Decimal(18, 6)
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  discount        Decimal        @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  amountPaid      Decimal        @default(0) @db.Decimal(18, 4)
  status          String         @default("OPEN") // OPEN, PARTIAL, PAID, OVERDUE, CANCELLED
  posted          Boolean        @default(false)
  postedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines    SupplierInvoiceLine[]
  payments SupplierPayment[]

  @@index([companyId, branchId])
  @@index([supplierId])
  @@index([status])
}

model SupplierInvoiceLine {
  id                  String          @id @default(cuid())
  invoiceId           String
  invoice             SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  productId           String?
  description         String?
  quantity            Decimal         @db.Decimal(18, 4)
  unitCost            Decimal         @db.Decimal(18, 4)
  taxAmount           Decimal         @default(0) @db.Decimal(18, 4)
  lineTotal           Decimal         @default(0) @db.Decimal(18, 4)

  @@index([invoiceId])
}

model PurchaseReturn {
  id         String   @id @default(cuid())
  companyId  String
  branchId   String
  supplierId String
  reference  String
  returnDate DateTime @default(now())
  reason     String?
  status     String   @default("POSTED")
  total      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt  DateTime @default(now())

  lines PurchaseReturnLine[]

  @@index([companyId, branchId])
}

model PurchaseReturnLine {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String?
  quantity         Decimal        @db.Decimal(18, 4)
  unitCost         Decimal        @db.Decimal(18, 4)
  taxAmount        Decimal        @default(0) @db.Decimal(18, 4)
  lineTotal        Decimal        @default(0) @db.Decimal(18, 4)

  @@index([purchaseReturnId])
}

model SupplierPayment {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  invoiceId     String?
  invoice       SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  reference     String
  paymentDate   DateTime         @default(now())
  amount        Decimal          @db.Decimal(18, 4)
  paymentMethod String
  bankAccountId String?
  bankAccount   BankAccount?     @relation(fields: [bankAccountId], references: [id])
  currency      String           @default("USD")
  exchangeRate  Decimal          @default(1) @db.Decimal(18, 6)
  notes         String?
  posted        Boolean          @default(false)
  postedAt      DateTime?
  createdAt     DateTime         @default(now())

  @@index([companyId, branchId])
  @@index([supplierId])
}

// ============================================================
// SALES & POS
// ============================================================

enum SaleType {
  POS
  INVOICE
  WHOLESALE
  RETAIL
  QUOTATION
}

enum SaleStatus {
  DRAFT
  HELD
  COMPLETED
  RETURNED
  CANCELLED
  VOID
  PARTIAL_RETURN
}

model Quotation {
  id         String    @id @default(cuid())
  companyId  String
  branchId   String
  customerId String?
  reference  String
  validUntil DateTime?
  status     String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, CONVERTED, EXPIRED, CANCELLED
  subtotal   Decimal   @default(0) @db.Decimal(18, 4)
  discount   Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount  Decimal   @default(0) @db.Decimal(18, 4)
  total      Decimal   @default(0) @db.Decimal(18, 4)
  createdAt  DateTime  @default(now())
  createdBy  String?

  lines QuotationLine[]

  @@index([companyId, branchId])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  quantity    Decimal   @db.Decimal(18, 4)
  unitPrice   Decimal   @db.Decimal(18, 4)
  discount    Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal   @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal   @default(0) @db.Decimal(18, 4)

  @@index([quotationId])
}

model SalesOrder {
  id         String   @id @default(cuid())
  companyId  String
  branchId   String
  customerId String?
  reference  String
  orderDate  DateTime @default(now())
  status     String   @default("DRAFT") // DRAFT, APPROVED, FULFILLED, PARTIAL, CANCELLED
  subtotal   Decimal  @default(0) @db.Decimal(18, 4)
  discount   Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount  Decimal  @default(0) @db.Decimal(18, 4)
  total      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt  DateTime @default(now())
  createdBy  String?

  lines SalesOrderLine[]

  @@index([companyId, branchId])
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  quantity     Decimal    @db.Decimal(18, 4)
  unitPrice    Decimal    @db.Decimal(18, 4)
  discount     Decimal    @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal    @default(0) @db.Decimal(18, 4)
  lineTotal    Decimal    @default(0) @db.Decimal(18, 4)

  @@index([salesOrderId])
}

model Sale {
  id                   String     @id @default(cuid())
  companyId            String
  branchId             String
  branch               Branch     @relation(fields: [branchId], references: [id])
  warehouseId          String?
  customerId           String?
  customer             Customer?  @relation(fields: [customerId], references: [id])
  reference            String
  type                 SaleType   @default(POS)
  status               SaleStatus @default(COMPLETED)
  saleDate             DateTime   @default(now())
  cashierId            String
  cashier              User       @relation("SaleCashier", fields: [cashierId], references: [id])
  shiftId              String?
  shift                POSShift?  @relation(fields: [shiftId], references: [id])
  subtotal             Decimal    @default(0) @db.Decimal(18, 4)
  discount             Decimal    @default(0) @db.Decimal(18, 4)
  taxAmount            Decimal    @default(0) @db.Decimal(18, 4)
  total                Decimal    @default(0) @db.Decimal(18, 4)
  amountPaid           Decimal    @default(0) @db.Decimal(18, 4)
  changeDue            Decimal    @default(0) @db.Decimal(18, 4)
  currency             String     @default("USD")
  exchangeRate         Decimal    @default(1) @db.Decimal(18, 6)
  paymentMethod        String?
  isCredit             Boolean    @default(false)
  creditDueDate        DateTime?
  discountApprovedById String?
  discountApprovedAt   DateTime?
  voidedById           String?
  voidedAt             DateTime?
  voidReason           String?
  heldId               String?
  notes                String?
  postedAt             DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  lines    SaleLine[]
  payments SalePayment[]
  returns  SaleReturn[]

  @@index([companyId, branchId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleLine {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal  @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 4)
  costPrice   Decimal? @db.Decimal(18, 4)
  discount    Decimal  @default(0) @db.Decimal(18, 4)
  taxRate     Decimal? @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal  @default(0) @db.Decimal(18, 4)

  @@index([saleId])
}

model SalePayment {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(18, 4)
  currencyAmount Decimal? @db.Decimal(18, 4)
  currency       String   @default("USD")
  exchangeRate   Decimal  @default(1) @db.Decimal(18, 6)
  paymentMethod  String
  reference      String?
  bankAccountId  String?
  createdAt      DateTime @default(now())
  createdBy      String?

  @@index([saleId])
}

model SaleReturn {
  id           String   @id @default(cuid())
  companyId    String
  branchId     String
  saleId       String?
  sale         Sale?    @relation(fields: [saleId], references: [id])
  customerId   String?
  reference    String
  returnDate   DateTime @default(now())
  reason       String?
  refundMethod String?
  refundAmount Decimal  @default(0) @db.Decimal(18, 4)
  status       String   @default("POSTED")
  createdById  String?
  createdAt    DateTime @default(now())

  lines SaleReturnLine[]

  @@index([companyId, branchId])
  @@index([saleId])
}

model SaleReturnLine {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String?
  quantity     Decimal    @db.Decimal(18, 4)
  unitPrice    Decimal    @db.Decimal(18, 4)
  taxAmount    Decimal    @default(0) @db.Decimal(18, 4)
  lineTotal    Decimal    @default(0) @db.Decimal(18, 4)

  @@index([saleReturnId])
}

model CustomerReceipt {
  id            String    @id @default(cuid())
  companyId     String
  branchId      String
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  reference     String
  receiptDate   DateTime  @default(now())
  amount        Decimal   @db.Decimal(18, 4)
  paymentMethod String
  bankAccountId String?
  invoiceId     String?
  notes         String?
  posted        Boolean   @default(false)
  postedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId, branchId])
  @@index([customerId])
}

// ============================================================
// POS SHIFT & CASH
// ============================================================

model POSShift {
  id               String    @id @default(cuid())
  companyId        String
  branchId         String
  cashierId        String
  cashier          User      @relation("ShiftCashier", fields: [cashierId], references: [id])
  terminal         String?
  status           String    @default("OPEN") // OPEN, CLOSED, CANCELLED
  openingFloat     Decimal   @default(0) @db.Decimal(18, 4)
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  expectedCash     Decimal   @default(0) @db.Decimal(18, 4)
  countedCash      Decimal?  @db.Decimal(18, 4)
  variance         Decimal?  @db.Decimal(18, 4)
  varianceNotes    String?
  varianceApproved Boolean   @default(false)
  closedById       String?
  createdAt        DateTime  @default(now())

  sales  Sale[]
  events POSShiftEvent[]

  @@index([companyId, branchId])
  @@index([cashierId])
  @@index([status])
}

enum POSShiftEventType {
  OPEN
  FLOAT
  CASH_DROP
  CASH_UP
  DECLARATION
  EXPENSE
  REFUND
  CLOSE
}

model POSShiftEvent {
  id          String            @id @default(cuid())
  shiftId     String
  shift       POSShift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type        POSShiftEventType
  amount      Decimal           @db.Decimal(18, 4)
  method      String?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([shiftId])
}

// ============================================================
// STOCK TRANSFERS
// ============================================================

enum TransferStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  IN_TRANSIT
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                     String         @id @default(cuid())
  companyId              String
  reference              String
  sourceBranchId         String
  sourceWarehouseId      String?
  destinationBranchId    String
  destinationWarehouseId String?
  status                 TransferStatus @default(REQUESTED)
  requestedById          String?
  approvedById           String?
  dispatchedById         String?
  receivedById           String?
  requestedAt            DateTime       @default(now())
  approvedAt             DateTime?
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  expectedAt             DateTime?
  note                   String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  sourceBranch      Branch              @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id])
  destinationBranch Branch              @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id])
  lines             StockTransferLine[]

  @@index([companyId, sourceBranchId])
  @@index([destinationBranchId])
  @@index([status])
}

model StockTransferLine {
  id            String        @id @default(cuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  requestedQty  Decimal       @db.Decimal(18, 4)
  dispatchedQty Decimal       @default(0) @db.Decimal(18, 4)
  receivedQty   Decimal       @default(0) @db.Decimal(18, 4)
  damagedQty    Decimal       @default(0) @db.Decimal(18, 4)
  unitCost      Decimal?      @db.Decimal(18, 4)

  @@index([transferId])
}

// ============================================================
// ACCOUNTING
// ============================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTRA_ASSET
  CONTRA_REVENUE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?              @relation(fields: [branchId], references: [id])
  code           String
  name           String
  type           AccountType
  category       String? // e.g. CASH, BANK, RECEIVABLE, PAYABLE, etc.
  normalBalance  AccountNormalBalance
  currency       String?              @default("USD")
  parentId       String?
  parent         Account?             @relation("AccountTree", fields: [parentId], references: [id])
  children       Account[]            @relation("AccountTree")
  isControl      Boolean              @default(false)
  isActive       Boolean              @default(true)
  description    String?
  openingBalance Decimal              @default(0) @db.Decimal(18, 4)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  journalLines           JournalLine[]
  bankAccounts           BankAccount[]
  cashAccountForBranchId String?
  cashAccountForBranch   Branch?           @relation("BranchCashAccounts", fields: [cashAccountForBranchId], references: [id])
  expenseCategories      ExpenseCategory[]

  @@unique([companyId, branchId, code])
  @@index([companyId])
  @@index([branchId])
}

model JournalEntry {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String?
  reference    String
  description  String?
  entryType    String // SALE, PURCHASE, PAYMENT, RECEIPT, EXPENSE, TRANSFER, ADJUSTMENT, OPENING, PAYROLL, DEPRECIATION
  sourceType   String?
  sourceId     String?
  currency     String    @default("USD")
  exchangeRate Decimal   @default(1) @db.Decimal(18, 6)
  entryDate    DateTime  @default(now())
  posted       Boolean   @default(false)
  postedAt     DateTime?
  reversed     Boolean   @default(false)
  reversedById String?
  reversedAt   DateTime?
  reversalOfId String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines     JournalLine[]
  relation  JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals JournalEntry[] @relation("Reversal")

  @@index([companyId, branchId])
  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@index([entryType])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  branchId       String?
  departmentId   String?
  costCentreId   String?
  profitCentreId String?
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
}

model BankAccount {
  id             String       @id @default(cuid())
  companyId      String
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id])
  accountName    String
  bankName       String
  accountNumber  String
  branchCode     String?
  swiftCode      String?
  currency       String       @default("USD")
  openingBalance Decimal      @default(0) @db.Decimal(18, 4)
  status         EntityStatus @default(ACTIVE)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions     BankTransaction[]
  reconciliations  BankReconciliation[]
  supplierPayments SupplierPayment[]

  @@index([companyId])
  @@index([branchId])
}

model BankTransaction {
  id               String      @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactionDate  DateTime    @default(now())
  description      String
  reference        String?
  withdrawal       Decimal     @default(0) @db.Decimal(18, 4)
  deposit          Decimal     @default(0) @db.Decimal(18, 4)
  balance          Decimal     @db.Decimal(18, 4)
  reconciled       Boolean     @default(false)
  reconciliationId String?
  sourceType       String? // DEPOSIT, WITHDRAWAL, TRANSFER, PAYMENT, RECEIPT
  sourceId         String?
  createdAt        DateTime    @default(now())

  @@index([bankAccountId])
  @@index([reconciled])
}

model BankReconciliation {
  id               String      @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementDate    DateTime    @default(now())
  statementBalance Decimal     @db.Decimal(18, 4)
  bookBalance      Decimal     @db.Decimal(18, 4)
  difference       Decimal     @db.Decimal(18, 4)
  status           String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  reconciledById   String?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())

  @@index([bankAccountId])
}

model FinancialPeriod {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  startDate  DateTime
  endDate    DateTime
  status     String    @default("OPEN") // OPEN, CLOSED, LOCKED
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================================
// TAX & CURRENCY
// ============================================================

model TaxRate {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  rate          Decimal   @db.Decimal(5, 2) // percentage
  type          String    @default("VAT") // VAT, INPUT, OUTPUT, ZERO_RATED, EXEMPT
  isCompound    Boolean   @default(false)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]

  @@index([companyId])
}

model Currency {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  symbol    String
  isBase    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  exchangeRates ExchangeRate[]

  @@unique([companyId, code])
  @@index([companyId])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  currencyId    String
  currency      Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  rateToBase    Decimal  @db.Decimal(18, 6)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([currencyId, effectiveDate])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id              String           @id @default(cuid())
  companyId       String
  branchId        String
  categoryId      String?
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id])
  reference       String
  expenseDate     DateTime         @default(now())
  description     String
  amount          Decimal          @db.Decimal(18, 4)
  taxAmount       Decimal          @default(0) @db.Decimal(18, 4)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  supplierId      String?
  paymentMethod   String?
  bankAccountId   String?
  paidById        String?
  paidBy          User?            @relation("ExpensePaidBy", fields: [paidById], references: [id])
  status          String           @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  approvedById    String?
  approvedAt      DateTime?
  receiptPath     String?
  posted          Boolean          @default(false)
  postedAt        DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId, branchId])
  @@index([expenseDate])
}

model ExpenseCategory {
  id        String       @id @default(cuid())
  companyId String
  name      String
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id])
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  expenses Expense[]

  @@unique([companyId, name])
}

model PettyCash {
  id          String       @id @default(cuid())
  companyId   String
  branchId    String
  name        String
  balance     Decimal      @default(0) @db.Decimal(18, 4)
  topUpAmount Decimal?     @db.Decimal(18, 4)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  @@index([companyId, branchId])
}

// ============================================================
// HR & PAYROLL
// ============================================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
  RESIGNED
  RETIRED
}

model Employee {
  id                String           @id @default(cuid())
  companyId         String
  branchId          String?
  branch            Branch?          @relation(fields: [branchId], references: [id])
  employeeNumber    String           @unique
  userId            String?          @unique
  user              User?            @relation(fields: [userId], references: [id])
  firstName         String
  lastName          String
  middleName        String?
  dateOfBirth       DateTime?
  gender            String?
  nationalId        String?
  phone             String?
  email             String?
  address           String?
  city              String?
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  positionId        String?
  position          Position?        @relation(fields: [positionId], references: [id])
  managerId         String?
  employmentType    String           @default("FULL_TIME")
  employmentStatus  EmploymentStatus @default(ACTIVE)
  hireDate          DateTime         @default(now())
  terminationDate   DateTime?
  salaryType        String           @default("MONTHLY") // MONTHLY, HOURLY, COMMISSION
  basicSalary       Decimal?         @default(0) @db.Decimal(18, 4)
  hourlyRate        Decimal?         @default(0) @db.Decimal(18, 4)
  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  nssaNumber        String?
  taxNumber         String?
  isSalaried        Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  allowances    EmployeeAllowance[]
  deductions    EmployeeDeduction[]
  leaveRequests LeaveRequest[]
  attendance    Attendance[]
  documents     EmployeeDocument[]
  loans         EmployeeLoan[]
  payrollLines  PayrollLine[]
  assets        Asset[]

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
}

model Position {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  departmentId String?
  createdAt    DateTime @default(now())

  employees Employee[]

  @@unique([companyId, name])
}

model EmployeeAllowance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  type       String // FIXED, PERCENTAGE
  amount     Decimal  @db.Decimal(18, 4)
  percentage Decimal? @db.Decimal(5, 2)
  isTaxable  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model EmployeeDeduction {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  type        String // FIXED, PERCENTAGE
  amount      Decimal  @db.Decimal(18, 4)
  percentage  Decimal? @db.Decimal(5, 2)
  isStatutory Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model EmployeeLoan {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount             Decimal   @db.Decimal(18, 4)
  monthlyDeduction   Decimal   @db.Decimal(18, 4)
  outstandingBalance Decimal   @default(0) @db.Decimal(18, 4)
  startDate          DateTime  @default(now())
  endDate            DateTime?
  status             String    @default("ACTIVE") // ACTIVE, COMPLETED, DEFAULTED
  createdAt          DateTime  @default(now())

  @@index([employeeId])
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  COMPASSIONATE
  STUDY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  TAKEN
}

model LeaveRequest {
  id           String      @id @default(cuid())
  companyId    String
  branchId     String?
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([employeeId])
  @@index([status])
}

model Attendance {
  id          String    @id @default(cuid())
  companyId   String
  branchId    String?
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  hoursWorked Decimal?  @db.Decimal(6, 2)
  status      String    @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  type         String
  filePath     String
  uploadedAt   DateTime @default(now())
  uploadedById String?

  @@index([employeeId])
}

model Payroll {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  reference       String?
  periodName      String
  periodStart     DateTime
  periodEnd       DateTime
  payDate         DateTime  @default(now())
  status          String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, POSTED, CANCELLED
  totalGross      Decimal   @default(0) @db.Decimal(18, 4)
  totalDeductions Decimal   @default(0) @db.Decimal(18, 4)
  totalNet        Decimal   @default(0) @db.Decimal(18, 4)
  totalTax        Decimal   @default(0) @db.Decimal(18, 4)
  approvedById    String?
  approvedAt      DateTime?
  posted          Boolean   @default(false)
  postedAt        DateTime?
  currency        String    @default("USD")
  exchangeRate    Decimal   @default(1) @db.Decimal(18, 6)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines PayrollLine[]

  @@index([companyId, branchId])
  @@index([status])
}

model PayrollLine {
  id                  String   @id @default(cuid())
  payrollId           String
  payroll             Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  basicSalary         Decimal  @default(0) @db.Decimal(18, 4)
  allowances          Decimal  @default(0) @db.Decimal(18, 4)
  bonuses             Decimal  @default(0) @db.Decimal(18, 4)
  overtime            Decimal  @default(0) @db.Decimal(18, 4)
  grossPay            Decimal  @default(0) @db.Decimal(18, 4)
  statutoryDeductions Decimal  @default(0) @db.Decimal(18, 4) // PAYE, NSSA
  otherDeductions     Decimal  @default(0) @db.Decimal(18, 4)
  loanDeductions      Decimal  @default(0) @db.Decimal(18, 4)
  totalDeductions     Decimal  @default(0) @db.Decimal(18, 4)
  netPay              Decimal  @default(0) @db.Decimal(18, 4)
  payeAmount          Decimal  @default(0) @db.Decimal(18, 4)
  nssaAmount          Decimal  @default(0) @db.Decimal(18, 4)
  pensionAmount       Decimal  @default(0) @db.Decimal(18, 4)
  currency            String   @default("USD")
  exchangeRate        Decimal  @default(1) @db.Decimal(18, 6)

  @@index([payrollId])
  @@index([employeeId])
}

model PayrollSetting {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  value         Decimal   @db.Decimal(18, 4)
  type          String // PAYE_BRACKET, NSSA_RATE, NSSA_CEILING, AID_LEVY, PENSION
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId, type])
}

// ============================================================
// FIXED ASSETS
// ============================================================

model AssetCategory {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  depreciationRate   Decimal  @default(0) @db.Decimal(5, 2)
  depreciationMethod String   @default("STRAIGHT_LINE")
  expenseAccountId   String?
  assetAccountId     String?
  createdAt          DateTime @default(now())

  assets Asset[]

  @@unique([companyId, name])
}

model Asset {
  id                      String         @id @default(cuid())
  companyId               String
  branchId                String?
  categoryId              String?
  category                AssetCategory? @relation(fields: [categoryId], references: [id])
  assetNumber             String         @unique
  name                    String
  description             String?
  serialNumber            String?
  purchaseDate            DateTime?
  purchaseCost            Decimal        @db.Decimal(18, 4)
  salvageValue            Decimal        @default(0) @db.Decimal(18, 4)
  usefulLifeYears         Int?
  depreciationRate        Decimal        @default(0) @db.Decimal(5, 2)
  accumulatedDepreciation Decimal        @default(0) @db.Decimal(18, 4)
  bookValue               Decimal        @db.Decimal(18, 4)
  status                  String         @default("ACTIVE") // ACTIVE, DISPOSED, IN_REPAIR, RETIRED
  location                String?
  assignedTo              String?
  assignedEmployeeId      String?
  assignedEmployee        Employee?      @relation(fields: [assignedEmployeeId], references: [id])
  supplierId              String?
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  deprecations AssetDepreciation[]

  @@index([companyId])
  @@index([branchId])
  @@index([categoryId])
}

model AssetDepreciation {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period    String
  amount    Decimal  @db.Decimal(18, 4)
  bookedAt  DateTime @default(now())
  journalId String?

  @@index([assetId])
}

// ============================================================
// SYSTEM: AUDIT, NOTIFICATIONS, NUMBERING, FILES, SETTINGS
// ============================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  CANCEL
  REVERSE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PRICE_CHANGE
  STOCK_ADJUSTMENT
  ACCOUNTING_ADJUSTMENT
  EXPORT
  PRINT
  VIEW
}

model AuditLog {
  id          String      @id @default(cuid())
  companyId   String
  branchId    String?
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  role        String?
  action      AuditAction
  entity      String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  description String?
  createdAt   DateTime    @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  companyId  String
  type       String // LOW_STOCK, PO_APPROVAL, TRANSFER_PENDING, TRANSFER_RECEIVED, INVOICE_OVERDUE, etc.
  title      String
  message    String?
  entityType String?
  entityId   String?
  branchId   String?
  priority   String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status     String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt  DateTime @default(now())

  userNotifications UserNotification[]

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model UserNotification {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@id([userId, notificationId])
  @@index([userId, readAt])
}

model DocumentSequence {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  docType   String // INVOICE, POS, PO, GRN, TRF, PAY, REC, etc.
  prefix    String
  separator String   @default("-")
  year      String?
  nextSeq   Int      @default(1)
  padding   Int      @default(6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, branchId, docType, year])
  @@index([companyId, docType])
}

model Attachment {
  id           String   @id @default(cuid())
  companyId    String
  entityType   String // SUPPLIER, CUSTOMER, PO, INVOICE, EXPENSE, EMPLOYEE, ASSET, PAYMENT, STOCK_ADJUSTMENT
  entityId     String
  fileName     String
  filePath     String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
}

model AppSetting {
  id        String   @id @default(cuid())
  companyId String
  group     String // COMPANY, TAX, CURRENCY, POS, ACCOUNTING, INVENTORY, PROCUREMENT, HR, PAYROLL, NOTIFICATIONS, SYSTEM, APPROVALS
  key       String
  value     String
  dataType  String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, group, key])
  @@index([companyId, group])
}

model ApprovalWorkflow {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  entityType String // PURCHASE_ORDER, EXPENSE, DISCOUNT, CREDIT_SALE, REFUND, STOCK_ADJUSTMENT, BRANCH_TRANSFER, SUPPLIER_PAYMENT, CUSTOMER_CREDIT_LIMIT, PAYROLL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  levels ApprovalLevel[]

  @@unique([companyId, entityType])
}

model ApprovalLevel {
  id         String           @id @default(cuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  level      Int
  roleId     String?
  role       Role?            @relation(fields: [roleId], references: [id])
  minAmount  Decimal?         @db.Decimal(18, 4)
  maxAmount  Decimal?         @db.Decimal(18, 4)
  createdAt  DateTime         @default(now())

  @@index([workflowId])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  companyId     String
  branchId      String?
  entityType    String
  entityId      String
  entityRef     String?
  requestedById String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  comments      String?
  currentLevel  Int       @default(1)
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  actions ApprovalAction[]

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([status])
}

model ApprovalAction {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  level             Int
  approverId        String?
  action            String // APPROVE, REJECT
  comments          String?
  actionAt          DateTime        @default(now())

  @@index([approvalRequestId])
}
model Recipe {
  id        String   @id @default(cuid())
  companyId String
  productId String   @unique // The product this recipe produces
  name      String
  yield     Decimal  @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  ingredients    RecipeItem[]
  productionRuns ProductionRun[]
}

model RecipeItem {
  id        String  @id @default(cuid())
  recipeId  String
  productId String // The ingredient product
  quantity  Decimal

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model ProductionRun {
  id          String   @id @default(cuid())
  companyId   String
  branchId    String
  warehouseId String
  reference   String
  recipeId    String
  status      String   @default("COMPLETED")
  outputQty   Decimal
  totalCost   Decimal
  createdById String
  createdAt   DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch           @relation(fields: [branchId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  recipe    Recipe           @relation(fields: [recipeId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  lines     ProductionLine[]
}

model ProductionLine {
  id        String  @id @default(cuid())
  runId     String
  productId String
  quantity  Decimal
  unitCost  Decimal

  run     ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}
